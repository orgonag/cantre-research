{
  "name": "@cantre/core",
  "version": "0.0.0",
  "private": true,
  "description": "CANTRE calculation core: geodesy, projection and milepost estimation.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "measure:distance": "npm run build && node scripts/measure-distance-error.mjs",
    "measure:snapshot": "npm run build && node --expose-gc scripts/measure-snapshot-decode.mjs"
  }
}
